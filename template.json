{
  "name": "n8n 2 AI Agent Stack (Ollama + Qdrant)",
  "description": "n8n queue mode with workers, local LLMs via Ollama and Qdrant memory.",
  "category": "Automation",
  "tags": [
    "n8n",
    "automation",
    "ai-agents",
    "ollama",
    "qdrant",
    "queue",
    "workers",
    "llm"
  ],
  "upstream": {
    "repo": "n8n-io/n8n",
    "version": "n8n@2.42.6",
    "checked": "2026-10-11"
  },
  "services": {
    "Gateway": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/nginx.svg",
      "source": {
        "repo": "baranberkay96/n8n-ai-stack-railway",
        "rootDirectory": "/services/gateway"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/gateway-healthz",
      "healthcheckTimeout": 120,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 8080,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Port nginx listens on (public domain target).",
          "required": false
        },
        "N8N_GW_MAIN_UPSTREAM": {
          "defaultValue": "${{n8n Main.RAILWAY_PRIVATE_DOMAIN}}:5678",
          "description": "n8n main (editor, API, push, test webhooks).",
          "required": false
        },
        "N8N_GW_WEBHOOK_UPSTREAM": {
          "defaultValue": "${{n8n Webhook.RAILWAY_PRIVATE_DOMAIN}}:5678",
          "description": "Webhook processor (/webhook, /webhook-waiting, /form, /form-waiting, /mcp).",
          "required": false
        },
        "NGINX_CLIENT_MAX_BODY_SIZE": {
          "defaultValue": "200M",
          "description": "Max request size (form uploads, binary webhooks).",
          "required": false
        },
        "NGINX_PROXY_TIMEOUT": {
          "defaultValue": "3600s",
          "description": "Proxy timeout for long webhook responses and push connections.",
          "required": false
        }
      }
    },
    "n8n Main": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/n8n.svg",
      "source": {
        "image": "n8nio/n8n:2.42.6"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/healthz/readiness",
      "healthcheckTimeout": 300,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "5678",
          "description": "Port Railway health-checks.",
          "required": false
        },
        "N8N_PORT": {
          "defaultValue": "5678",
          "description": "n8n HTTP port.",
          "required": false
        },
        "N8N_LISTEN_ADDRESS": {
          "defaultValue": "::",
          "description": "Listen on IPv4+IPv6.",
          "required": false
        },
        "N8N_EDITOR_BASE_URL": {
          "defaultValue": "https://${{Gateway.RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public editor URL (links in emails, OAuth callbacks).",
          "required": false
        },
        "OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS": {
          "defaultValue": "true",
          "description": "Run editor/test executions on workers too (main never runs Code nodes).",
          "required": false
        },
        "N8N_DISABLE_PRODUCTION_MAIN_PROCESS": {
          "defaultValue": "true",
          "description": "Production webhooks are served by the n8n Webhook service via the Gateway.",
          "required": false
        },
        "N8N_PERSONALIZATION_ENABLED": {
          "defaultValue": "false",
          "description": "Skip the onboarding survey.",
          "required": false
        },
        "EXECUTIONS_MODE": {
          "defaultValue": "queue",
          "description": "Queue mode: main/webhook enqueue executions in Redis, workers run them.",
          "required": false
        },
        "DB_TYPE": {
          "defaultValue": "postgresdb",
          "description": "Database type.",
          "required": false
        },
        "DB_POSTGRESDB_HOST": {
          "defaultValue": "${{Postgres.PGHOST}}",
          "description": "Postgres private host.",
          "required": false
        },
        "DB_POSTGRESDB_PORT": {
          "defaultValue": "${{Postgres.PGPORT}}",
          "description": "Postgres port.",
          "required": false
        },
        "DB_POSTGRESDB_DATABASE": {
          "defaultValue": "${{Postgres.PGDATABASE}}",
          "description": "Postgres database.",
          "required": false
        },
        "DB_POSTGRESDB_USER": {
          "defaultValue": "${{Postgres.PGUSER}}",
          "description": "Postgres user.",
          "required": false
        },
        "DB_POSTGRESDB_PASSWORD": {
          "defaultValue": "${{Postgres.PGPASSWORD}}",
          "description": "Postgres password.",
          "required": false
        },
        "QUEUE_BULL_REDIS_HOST": {
          "defaultValue": "${{Redis.REDISHOST}}",
          "description": "Redis private host.",
          "required": false
        },
        "QUEUE_BULL_REDIS_PORT": {
          "defaultValue": "${{Redis.REDISPORT}}",
          "description": "Redis port.",
          "required": false
        },
        "QUEUE_BULL_REDIS_USERNAME": {
          "defaultValue": "${{Redis.REDISUSER}}",
          "description": "Redis user.",
          "required": false
        },
        "QUEUE_BULL_REDIS_PASSWORD": {
          "defaultValue": "${{Redis.REDIS_PASSWORD}}",
          "description": "Redis password.",
          "required": false
        },
        "QUEUE_BULL_REDIS_DUALSTACK": {
          "defaultValue": "true",
          "description": "Resolve Redis over IPv4 and IPv6 (Railway private network).",
          "required": false
        },
        "N8N_ENCRYPTION_KEY": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Encrypts stored credentials; identical on every n8n process. Never change after first boot.",
          "required": false
        },
        "N8N_USER_MANAGEMENT_JWT_SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs login sessions; identical on every n8n process.",
          "required": false
        },
        "WEBHOOK_URL": {
          "defaultValue": "https://${{Gateway.RAILWAY_PUBLIC_DOMAIN}}/",
          "description": "Public base for webhook, form, chat and MCP URLs (the Gateway).",
          "required": false
        },
        "N8N_PROXY_HOPS": {
          "defaultValue": "2",
          "description": "Trusted proxies in front of n8n (Railway edge + Gateway) for correct client IPs.",
          "required": false
        },
        "N8N_DEFAULT_BINARY_DATA_MODE": {
          "defaultValue": "database",
          "description": "Binary data in Postgres so main, webhook and workers share files (filesystem mode is unsupported in queue mode).",
          "required": false
        },
        "N8N_REINSTALL_MISSING_PACKAGES": {
          "defaultValue": "true",
          "description": "Reinstall community nodes on boot (no shared volume between processes).",
          "required": false
        },
        "GENERIC_TIMEZONE": {
          "defaultValue": "Etc/UTC",
          "description": "Default timezone for schedules (e.g. Europe/Istanbul).",
          "required": false
        },
        "N8N_LOG_LEVEL": {
          "defaultValue": "info",
          "description": "Log level.",
          "required": false
        },
        "N8N_DIAGNOSTICS_ENABLED": {
          "defaultValue": "false",
          "description": "Disable anonymous telemetry.",
          "required": false
        },
        "N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS": {
          "defaultValue": "true",
          "description": "Strict permissions on the n8n settings file.",
          "required": false
        }
      }
    },
