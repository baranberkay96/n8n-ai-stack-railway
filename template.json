    "Ollama": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/ollama.svg",
      "source": {
        "repo": "baranberkay96/n8n-ai-stack-railway",
        "rootDirectory": "/services/ollama"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/",
      "healthcheckTimeout": 300,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/root/.ollama"
      },
      "variables": {
        "PORT": {
          "defaultValue": "11434",
          "description": "Ollama API port (private).",
          "required": false
        },
        "OLLAMA_HOST": {
          "defaultValue": "[::]:11434",
          "description": "Bind address for the Ollama API (IPv4+IPv6).",
          "required": false
        },
        "OLLAMA_PULL_MODELS": {
          "defaultValue": "llama3.2:3b,nomic-embed-text:v1.5",
          "description": "Models pulled on first boot (comma-separated). Chat model + embedding model for Qdrant RAG.",
          "required": false
        },
        "OLLAMA_CONTEXT_LENGTH": {
          "defaultValue": "8192",
          "description": "Default context window (agents with tools need more than 4k).",
          "required": false
        },
        "OLLAMA_KEEP_ALIVE": {
